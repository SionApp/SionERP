exports[`BlockRenderer — one snapshot per block type (E.7) > renders callout 1`] = `"<div class="flex items-start rounded-md3-block bg-edu-orange-container mt-6 gap-3.5 px-6 py-5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb shrink-0 text-on-edu-orange-container h-6 w-6" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg><p class="text-edu-callout-text text-[0.9375em] leading-[1.65]"><span>Aviso de ejemplo</span></p></div>"`;

