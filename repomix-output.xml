            <div className="p-6 bg-muted/30">
              <div className="text-center">
                <p className="text-sm text-muted-foreground mb-4">
                  {isLive
                    ? '¡Gracias por acompañarnos en este servicio!'
                    : 'Nos vemos en nuestro próximo servicio en vivo'}
