        return 'Pastor';
      case 'staff':
        return 'Staff';
      case 'supervisor':
        return 'Supervisor';
      case 'server':
        return 'Servidor';
      default:
        return role;
    }
  };
  const loadInvitations = async () => {
    try {
      setLoadingInvitations(true);
      const invitations = await UserService.loadInvitations();
      setInvitations(invitations || []);
