if [ ! -d "$ROOT_DIR/apps/backend-go" ]; then
    echo "❌ No se encontró el directorio $ROOT_DIR/apps/backend-go"
    exit 1
fi

# Ir al directorio del backend
cd "$ROOT_DIR/apps/backend-go"

# Verificar si existe .env
if [ ! -f ".env" ]; then
