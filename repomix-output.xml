              )}
              <Button type="submit" disabled={loading} className={isEditMode ? 'flex-1' : 'w-full'}>
                {loading
                  ? isEditMode
                    ? 'Actualizando...'
                    : 'Registrando...'
                  : isEditMode
                    ? 'Actualizar Usuario'
                    : 'Registrar Usuario'}
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>
    </div>
  );
};

