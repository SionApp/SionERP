            </Button>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}

function NoAccessCard({
  module,
  requiredLevel,
}: {
  module: string;
  requiredLevel: number;
}) {
  const levelNames: Record<number, string> = {
    2: 'Supervisor Auxiliar',
    3: 'Supervisor General',
    4: 'Coordinador',
    5: 'Pastoral',
  };

  return (
    <Card>
