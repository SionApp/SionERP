  priority INTEGER DEFAULT 2 CHECK (priority IN (1, 2, 3)),
  
  -- A quién compete
  created_by UUID REFERENCES users(id) NOT NULL,
  supervisor_id UUID REFERENCES users(id),
  zone_id UUID REFERENCES zones(id),
  
  -- Para prórrogas
  extension_count INT DEFAULT 0,
